   10 REM MANDELBROT SET - MODE 2
   20 MODE 2:VDU 23,1,0;0;0;0;
   30 MI%=32
   40 FOR Y%=0 TO 127
   50 CI=(Y%-127.5)*0.01:C2=CI*CI
   60 FOR X%=0 TO 159
   70 CR=X%*0.02-2.2:N%=MI%
   80 Q=(CR-0.25)^2+C2
   90 IF Q*(Q+CR-0.25)<C2/4 OR (CR+1)^2+C2<0.0625 THEN 160
  100 ZR=0:ZI=0:N%=0
  110 REPEAT
  120 T=ZR*ZR-ZI*ZI+CR
  130 ZI=2*ZR*ZI+CI:ZR=T:N%=N%+1
  140 UNTIL N%=MI% OR ZR*ZR+ZI*ZI>4
  150 IF N%=MI% THEN C%=0 ELSE C%=1+N% MOD 7
  160 IF N%=MI% THEN C%=0
  170 GCOL 0,C%
  180 PLOT 69,X%*8,Y%*4:PLOT 69,X%*8,1020-Y%*4
  190 NEXT
  200 NEXT
  210 A$=GET$
  220 MODE 7
