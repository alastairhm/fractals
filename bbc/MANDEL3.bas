   10 REM MANDELBROT - ECF SHADING
   20 MODE 2:VDU 23,1,0;0;0;0;
   30 MI%=64:LK%=-1:L2=LN(2)
   40 DIM R%(6):FOR I%=0 TO 6:READ R%(I%):NEXT
   50 DATA 4,6,7,3,1,5,4
   60 FOR P%=8 TO 0 STEP -1
   70 S%=2^P%:T%=S%*2
   80 FOR Y%=0 TO 127 STEP S%
   90 CI=(Y%-127.5)*0.01:C2=CI*CI
  100 FOR X%=0 TO 159 STEP S%
  110 IF P%<8 AND X% MOD T%=0 AND Y% MOD T%=0 THEN 150
  120 PROCPIXEL
  130 L%=X%*8:B%=Y%*4:E%=L%+S%*8-1:U%=B%+S%*4-1
  140 MOVE L%,B%:PLOT 101,E%,U%:MOVE L%,1023-U%:PLOT 101,E%,1023-B%
  150 NEXT
  160 NEXT
  170 NEXT
  180 A$=GET$
  190 MODE 7
  200 END
  210 DEF PROCPIXEL
  220 CR=X%*0.02-2.2
  230 Q=(CR-0.25)^2+C2
  240 IF Q*(Q+CR-0.25)<C2/4 OR (CR+1)^2+C2<0.0625 THEN GCOL 0,0:ENDPROC
  250 ZR=0:ZI=0:N%=0
  260 REPEAT
  270 T=ZR*ZR-ZI*ZI+CR
  280 ZI=2*ZR*ZI+CI:ZR=T:N%=N%+1:M=ZR*ZR+ZI*ZI
  290 UNTIL N%=MI% OR M>65536
  300 IF N%=MI% THEN GCOL 0,0:ENDPROC
  310 V=(N%+1-LN(LN(M)/2)/L2)/4
  320 I%=INT(V):K%=INT((V-I%)*4):I%=I% MOD 6
  330 IF K%=0 THEN GCOL 0,R%(I%):ENDPROC
  340 IF I%*4+K%<>LK% THEN PROCPAT
  350 GCOL 16,0
  360 ENDPROC
  370 DEF PROCPAT
  380 A%=R%(I%):B%=R%(I%+1):LK%=I%*4+K%
  390 IF K%=1 THEN VDU 23,12,B%,A%,A%,A%,A%,B%,A%,A%
  400 IF K%=2 THEN VDU 23,12,A%,B%,B%,A%,A%,B%,B%,A%
  410 IF K%=3 THEN VDU 23,12,A%,B%,B%,B%,B%,A%,B%,B%
  420 ENDPROC
