   10 REM MANDELBROT - PROGRESSIVE
   20 MODE 2:VDU 23,1,0;0;0;0;
   30 MI%=32
   40 FOR P%=8 TO 0 STEP -1
   50 S%=2^P%:T%=S%*2
   60 FOR Y%=0 TO 127 STEP S%
   70 CI=(Y%-127.5)*0.01:C2=CI*CI
   80 FOR X%=0 TO 159 STEP S%
   90 IF P%<8 AND X% MOD T%=0 AND Y% MOD T%=0 THEN 130
  100 PROCPIXEL
  110 GCOL 0,C%
  120 IF S%=1 THEN PLOT 69,X%*8,Y%*4:PLOT 69,X%*8,1020-Y%*4 ELSE PROCBLOCK
  130 NEXT
  140 NEXT
  150 NEXT
  160 A$=GET$
  170 MODE 7
  180 END
  200 DEF PROCPIXEL
  210 CR=X%*0.02-2.2:N%=MI%
  220 Q=(CR-0.25)^2+C2
  230 IF Q*(Q+CR-0.25)<C2/4 OR (CR+1)^2+C2<0.0625 THEN C%=0:ENDPROC
  240 ZR=0:ZI=0:N%=0
  250 REPEAT
  260 T=ZR*ZR-ZI*ZI+CR
  270 ZI=2*ZR*ZI+CI:ZR=T:N%=N%+1
  280 UNTIL N%=MI% OR ZR*ZR+ZI*ZI>4
  290 IF N%=MI% THEN C%=0 ELSE C%=1+N% MOD 7
  300 ENDPROC
  310 DEF PROCBLOCK
  320 L%=X%*8:R%=L%+S%*8-1:B%=Y%*4:U%=B%+S%*4-1
  330 MOVE L%,B%:MOVE R%,B%:PLOT 85,L%,U%:PLOT 85,R%,U%
  340 MOVE L%,1023-U%:MOVE R%,1023-U%:PLOT 85,L%,1023-B%:PLOT 85,R%,1023-B%
  350 ENDPROC
