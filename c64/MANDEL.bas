10 REM MANDELBROT SET - C64 MULTICOLOUR
20 POKE 55,0:POKE 56,32:CLR
30 ZR=0:ZI=0:A=0:B=0:CR=0:CI=0:F=4:N=0:M=32:X=0:R=0:S=0:C=0
40 DIM W(3),K(33):W(0)=64:W(1)=16:W(2)=4:W(3)=1
50 FOR I=1 TO 32:K(I)=1+I-INT(I/3)*3:NEXT
60 POKE 53280,0:POKE 53281,0
70 POKE 53272,24:POKE 53265,59:POKE 53270,216
80 FOR I=1024 TO 2023:POKE I,110:POKE I+54272,1:NEXT
90 FOR I=8192 TO 16191:POKE I,0:NEXT
100 T0=TI
110 FOR Y=0 TO 99
120 CI=(Y-99.5)*.0115:C2=CI*CI:Z=199-Y
130 R=8192+INT(Y/8)*320+(Y AND 7):S=8192+INT(Z/8)*320+(Z AND 7)
140 FOR X=0 TO 159
150 CR=X*.0216-2.48:N=M+1
160 Q=CR-.25:Q=Q*Q+C2:IF Q*(Q+CR-.25)<C2*.25 THEN 200
170 IF (CR+1)*(CR+1)+C2<.0625 THEN 200
180 ZR=0:ZI=0:A=0:B=0
190 FOR N=1 TO M:ZI=(ZR+ZR)*ZI+CI:ZR=A-B+CR:A=ZR*ZR:B=ZI*ZI:IF A+B<F THEN NEXT
200 C=K(N):IF C=0 THEN 220
210 V=C*W(X AND 3):O=INT(X/4)*8:POKE R+O,PEEK(R+O)OR V:POKE S+O,PEEK(S+O)OR V
220 NEXT X
230 NEXT Y
240 T=TI-T0
250 GET A$:IF A$="" THEN 250
260 POKE 53265,27:POKE 53270,200:POKE 53272,21
270 PRINT CHR$(147)"TIME"INT(T/60)"SECONDS"
